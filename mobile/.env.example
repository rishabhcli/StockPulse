# StockPulse Mobile App Environment Variables
# Copy this file to .env and update values as needed

# API URL (optional - defaults to localhost in development)
# For physical device testing, use your computer's IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
#
# For production, set to your deployed API URL
# Example: EXPO_PUBLIC_API_URL=https://stockpulse-api.railway.app
EXPO_PUBLIC_API_URL=

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
